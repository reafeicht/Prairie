{
    "name": "reafeicht/prairie",
    "description": "Gorgeous UI components for Livewire powered by daisyUI and Tailwind",
    "license": "MIT",
    "authors": [
        {
            "name": "Rea Feichtinger",
            "email": "qualitycoder11660@proton.me",
            "homepage": "https://github.com/reafeicht"
        }
    ],
    "homepage": "https://github.com/reafeicht/prairie",
    "keywords": [
        "laravel",
        "livewire",
        "livewire ui",
        "livewire ui components",
        "tallstack",
        "tallstack ui",
        "tallstackui",
        "tallstack components",
        "blade",
        "ui",
        "blade ui components",
        "livewire-components",
        "livewire components",
        "livewire-packages",
        "livewire packages",
        "tailwind",
        "components",
        "daisyUI",
        "alpinejs"
    ],
    "require": {
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "jfcherng/php-diff": "^6.15",
        "laravel/prompts": "^0|^1",
        "blade-ui-kit/blade-heroicons": "^2.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10|^11|^12.5.12",
        "orchestra/testbench": "^8|^9|^10|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Prairie\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Prairie\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Prairie\\PrairieServiceProvider"
            ],
            "aliases": {
                "Prairie": "Prairie\\Facades\\Prairie"
            }
        }
    }
}
